<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_mpti_inherit" model="ir.ui.view">
        <field name="name">res.users.form.mpti.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='public']" position="after">
                <page string="Informasi Mahasiswa" name="student_info">
                    <group>
                        <group string="Data Pribadi">
                            <field name="jenis_kelamin"/>
                            <field name="no_telepon"/>
                        </group>
                        <group string="Akademik">
                            <field name="instansi"/>
                            <field name="tanggal_daftar" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
