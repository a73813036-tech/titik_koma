<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_mood_tracking_tree" model="ir.ui.view">
        <field name="name">student.mood.tracking.tree</field>
        <field name="model">student.mood.tracking</field>
        <field name="arch" type="xml">
            <tree string="Mood Tracking">
                <field name="date"/>
                <field name="student_id"/>
                <field name="mood_level"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_student_mood_tracking_form" model="ir.ui.view">
        <field name="name">student.mood.tracking.form</field>
        <field name="model">student.mood.tracking</field>
        <field name="arch" type="xml">
            <form string="Mood Tracking">
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="date"/>
                        <field name="mood_level"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_mood_tracking" model="ir.actions.act_window">
        <field name="name">Mood Tracking</field>
        <field name="res_model">student.mood.tracking</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Catat mood harian Anda di sini.
            </p>
        </field>
    </record>

    <menuitem id="menu_mood_tracking_root" name="Mood Tracking" sequence="10"/>
    <menuitem id="menu_mood_tracking" name="My Mood" parent="menu_mood_tracking_root" action="action_student_mood_tracking" sequence="10"/>
</odoo>
